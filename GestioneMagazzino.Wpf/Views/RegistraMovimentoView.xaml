<UserControl x:Class="GestioneMagazzino.Wpf.Views.RegistraMovimentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GestioneMagazzino.Wpf.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid Margin="44,40,44,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Registra movimento" FontSize="28" FontWeight="Bold" Foreground="#14213D" Margin="0,0,0,4"/>
            <TextBlock Text="Registra un carico o uno scarico di magazzino" FontSize="14" Foreground="#6B7280"/>
        </StackPanel>
        
        <Grid Grid.Row="1" Margin="0,28,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
           

            <Border Style="{StaticResource CardBorder}" Padding="32">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel  Margin="0,0,0,22">
                        <TextBlock Text="Prodotto" FontSize="13" FontWeight="SemiBold" Foreground="#14213D" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding ListaProdotti}" SelectedItem="{Binding ProdottoSelezionato}" FontSize="14" Padding="14,12">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CodiceProdotto}"/>
                                        <TextBlock Text=" - "/>
                                        <TextBlock Text="{Binding Nome}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,22">
                        <TextBlock Text="Tipo movimento" FontSize="13" FontWeight="SemiBold" Foreground="#14213D" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton Content="Carico" Style="{StaticResource PulsanteTipo}" IsChecked="True" Command="{Binding SelezionaCaricoCommand}"/>
                            <RadioButton Grid.Column="2" Content="Scarico"  Style="{StaticResource PulsanteTipo}" Command="{Binding SelezionaScaricoCommand}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,22">
                        <TextBlock Text="Quantità" FontSize="13" FontWeight="SemiBold" Foreground="#14213D" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding Quantita,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CampoTesto}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="{Binding MessaggioErrore}" Foreground="#C0392B" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <Button Grid.Row="4" Content="Registra movimento" Style="{StaticResource PulsantePrimario}" Background="#14213D" FontSize="15" Command="{Binding RegistraCommand}"/>

                    <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Margin="0,0,0,12">
                        <TextBlock Text="{Binding MessaggioConferma}" Foreground="green" FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding MessaggioAvviso}" Foreground="Orange" FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding MessaggioErrore}" Foreground="Red" FontSize="13" TextWrapping="Wrap"/>

                    </StackPanel>
                    
                </Grid>
                
                
               
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="28">
                <StackPanel>
                    <TextBlock Text="PRODOTTO SELEZIONATO" FontSize="13" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,18"/>
                    <TextBlock Text="{Binding ProdottoSelezionato.Nome}" FontSize="20" FontWeight="Bold" Foreground="#14213D"/>
                    <TextBlock Text="{Binding ProdottoSelezionato.Codice}" FontSize="13" FontFamily="Consolas" Foreground="#6B7280" Margin=" 0,0,0,18"/>
                    <Grid Margin="0,0,0,18">
                        <TextBlock Text="Quantita attuale" FontSize="13" Foreground="#6B7280" />
                        <TextBlock Text="{Binding ProdottoSelezionato.QuantitaAttuale}" FontSize="13" Foreground="#14213D" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        
                    </Grid>
                    <Border BorderBrush="#EEF0F3" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Soglia minima" FontSize="13" Foreground="#6B7280"/>
                                <TextBlock Text="{Binding ProdottoSelezionato.SogliaMinima}" FontSize="13" Foreground="#14213D" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Prezzo unitario" FontSize="13" Foreground="#6B7280"/>
                                <TextBlock Text="{Binding ProdottoSelezionato.PrezzoUnitario, StringFormat='€ {0:N2}'}" FontSize="13" Foreground="#14213D" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                
                            </Grid>
                            <Grid>
                                <TextBlock Text="Valore scorta" FontSize="13" Foreground="#6B7280"/>
                                <TextBlock Text="{Binding ValoreScorta, StringFormat='€ {0:N2}'}" FontSize="13" Foreground="#14213D" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
            
        </Grid>
        
            
    </Grid>
</UserControl>
