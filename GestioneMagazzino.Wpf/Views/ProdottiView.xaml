<UserControl x:Class="GestioneMagazzino.Wpf.Views.ProdottiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GestioneMagazzino.Wpf.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="44,40,44,40">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>


        <TextBlock Grid.Row="0" Text="Prodotti" Style="{StaticResource TitoloPagine}"/>
        <TextBlock Grid.Row="1" Text="Elenco completo dei prodotti a magazzino" FontSize="14" Foreground="#6B7280"/>
        <Button Grid.Row="0" Grid.RowSpan="2" Content="Aggiungi prodotto" Style="{StaticResource PulsantePrimario}" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding AggiungiProdottoCommand}"/>
        <!-- Card della tabella:-->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0" Margin="0,24,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <!-- RIGA DI INTESTAZIONE-->
                <Border Grid.Row="0" Background="#FAFBFC" Padding="24,16" BorderBrush="#E3E6EB" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CODICE" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280"/>
                        <TextBlock Grid.Column="1" Text="NOME" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280"/>
                        <TextBlock Grid.Column="2" Text="PREZZO" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280"/>
                        <TextBlock Grid.Column="3" Text="QUANTITÀ" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280"/>
                        <TextBlock Grid.Column="4" Text="SOGLIA MIN." FontSize="12" FontWeight="SemiBold" Foreground="#6B7280"/>
                        <TextBlock Grid.Column="5" Text="STATO" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280"/>
                    </Grid>
                </Border>
                

                <!-- RIGHE: una per prodotto -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ListaProdotti}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Sfondo nello Style-->
                                <Border BorderBrush="#EEF0F3" BorderThickness="0,0,0,1" Padding="24,16">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SottoSoglia}" Value="True">
                                                    <Setter Property="Background" Value="#FDF6F5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <!-- Le STESSE 6 colonne dell'intestazione -->
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Codice}" FontSize="13" Foreground="#6B7280" FontFamily="Consolas" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Nome}" FontSize="14" FontWeight="SemiBold" Foreground="#14213D" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Prezzo, StringFormat='€ {0:N2}'}" FontSize="14" Foreground="#14213D" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Quantita}" FontSize="14" Foreground="#14213D" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding SogliaMinima}" FontSize="14" Foreground="#6B7280" VerticalAlignment="Center"/>

                                        <!-- Badge stato: colori e testo nei Setter, cambiati dai DataTrigger -->
                                        <Border Grid.Column="5" CornerRadius="999" Padding="12,4" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SottoSoglia}" Value="True">
                                                            <Setter Property="Background" Value="#FDEDEC"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <TextBlock FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="OK"/>
                                                        <Setter Property="Foreground" Value="#2F855A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SottoSoglia}" Value="True">
                                                                <Setter Property="Text" Value="Sotto soglia"/>
                                                                <Setter Property="Foreground" Value="#C0392B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>

