<UserControl x:Class="GestioneMagazzino.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GestioneMagazzino.Wpf.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <!-- Area principale -->
    <Grid Margin="44,40,44,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Margin="44,40,44,40">
            <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold" Foreground="#14213D" Margin="0,0,0,4"/>
            <TextBlock Text="Panoramica generale del magazzino" FontSize="14" Foreground="#6B7280"/>
        </StackPanel>

        <!-- 4 card: colonne 0,2,4,6 per le card, 1,3,5 come spazi da 20 -->
        <Grid Grid.Row="1" Margin="0,28,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorder}">
                
                <StackPanel>
                    <TextBlock Text="Prodotti totali" Style="{StaticResource CardEtichetta}"/>
                    <TextBlock Text="{Binding ProdottiTotali}" Style="{StaticResource CardValore}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Sotto soglia" Style="{StaticResource CardEtichetta}"/>
                    <TextBlock Text="{Binding SottoSoglia}" Style="{StaticResource CardValore}" Foreground="#C0392B"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Valore magazzino" Style="{StaticResource CardEtichetta}"/>
                    <TextBlock Text="{Binding ValoreMagazzino, StringFormat='€ {0:N2}'}" Style="{StaticResource CardValore}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Movimenti oggi" Style="{StaticResource CardEtichetta}"/>
                    <TextBlock Text="{Binding MovimentiOggi}" Style="{StaticResource CardValore}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2 card grandi: colonna 1 come spazio da 20 -->
        <Grid Grid.Row="2" Margin="0,28,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Prodotti sotto soglia -->
            <Border Style="{StaticResource CardBorder}" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="Prodotti sotto soglia" FontWeight="SemiBold" FontSize="15" Foreground="#14213D" Margin="0,0,0,14"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ProdottiSottoSoglia}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FDEDEC" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Nome}" FontSize="14" FontWeight="SemiBold" Foreground="#14213D"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Codice " FontSize="12" Foreground="#6B7280"/>
                                                    <TextBlock Text="{Binding CodiceProdotto}" FontSize="12" Foreground="#6B7280"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding QuantitaAttuale}" FontSize="13" FontWeight="SemiBold" Foreground="#C0392B"/>
                                                <TextBlock Text=" / " FontSize="13" FontWeight="SemiBold" Foreground="#C0392B"/>
                                                <TextBlock Text="{Binding SogliaMinima}" FontSize="13" FontWeight="SemiBold" Foreground="#C0392B"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Ultimi movimenti -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Ultimi movimenti" FontWeight="SemiBold" FontSize="15" Foreground="#14213D" Margin="0,0,0,14"/>
                    <ScrollViewer Grid.Row="1"  VerticalScrollBarVisibility="Auto">
                        
                        <ItemsControl ItemsSource="{Binding UltimiMovimenti}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,10" BorderBrush="#EEF0F3" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <TextBlock Text="{Binding NomeProdotto}" FontSize="14" Foreground="#14213D" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <!-- Badge: i colori stanno nello Style, non come attributi,altrimenti il DataTrigger non potrebbe cambiarli -->
                                                <Border CornerRadius="999" Padding="10,3">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#E8F5E9"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tipo}" Value="Scarico">
                                                                    <Setter Property="Background" Value="#FDEDEC"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <TextBlock Text="{Binding Tipo}" FontSize="12" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#2F855A"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Tipo}" Value="Scarico">
                                                                        <Setter Property="Foreground" Value="#C0392B"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding Quantita}" FontSize="13" Foreground="#6B7280" Width="36" TextAlignment="Right" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

    </Grid>
    
</UserControl>
