<Window x:Class="GestioneMagazzino.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestioneMagazzino.Wpf"
        xmlns:views="clr-namespace:GestioneMagazzino.Wpf.Views"
        xmlns:vm="clr-namespace:GestioneMagazzino.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Gestione Magazzino" Height="800" Width="1280"
        Language="it-IT">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProdottiViewModel}">
            <views:ProdottiView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NuovoProdottoViewModel}">
            <views:NuovoProdottoView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RegistraMovimentoViewModel}">
            <views:RegistraMovimentoView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StoricoMovimentiViewModel}">
            <views:StoricoMovimentiView/>
        </DataTemplate>

    </Window.Resources>
        
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Rectangle Fill="#14213D"/>
        <Rectangle Grid.Column="1" Fill="#F5F6F8"/>

        <!-- Sidebar -->
        <StackPanel Margin="16,28,16,0">
            <TextBlock Text="Magazzino" FontSize="17" FontWeight="Bold" Foreground="White" Margin="8,0,0,32"/>
            <RadioButton Content="Dashboard" Command="{Binding MostraDashboardCommand}" Style="{StaticResource VoceMenu}" IsChecked="True"/>
            <RadioButton Content="Prodotti" Command="{Binding MostraProdottiCommand}" Style="{StaticResource VoceMenu}"/>
            <RadioButton Content="Registra movimento" Command="{Binding MostraRegistraMovimentoCommand}" Style="{StaticResource VoceMenu}"/>
            <RadioButton Content="Storico movimenti" Command="{Binding MostraStoricoMovimentiCommand}" Style="{StaticResource VoceMenu}"/>
        </StackPanel>

        <ContentControl Grid.Column="1" Content="{Binding ViewModelCorrente}"/>

    </Grid>
</Window>
